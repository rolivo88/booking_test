    {
      "name": "7. Flujo Completo E2E",
      "item": [
        {
          "name": "PASO 1 - Crear booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('booking_id', json.id);",
                  "pm.test('Estado es DRAFT', () => pm.expect(json.status).to.eql('DRAFT'));",
                  "pm.test('totalAmount calculado: 5000', () => pm.expect(json.items[0].totalAmount).to.eql(5000.00));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"bookingCode\": \"BOOK-E2E-001\",\n  \"issueDate\": \"2026-07-15\",\n  \"expirationDate\": \"2026-12-31\",\n  \"currency\": \"USD\",\n  \"incotermCode\": \"CIF\",\n  \"freightMode\": \"AIR\",\n  \"originCountry\": \"Germany\",\n  \"destinationCountry\": \"Chile\",\n  \"fobValue\": 50000.00,\n  \"supplierTaxId\": \"TAX-77000333-3\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-MTR-E2E\",\n      \"description\": \"Motor industrial de prueba\",\n      \"quantity\": 5,\n      \"unitPrice\": 1000.00\n    }\n  ]\n}"
            },
            "url": {
