    {
      "name": "2. Crear Booking",
      "item": [
        {
          "name": "POST - Crear booking exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('booking_id', json.id);",
                  "    pm.test('Estado es DRAFT', () => pm.expect(json.status).to.eql('DRAFT'));",
                  "    pm.test('Tiene supplier', () => pm.expect(json.supplier).to.not.be.null);",
                  "    pm.test('Tiene items', () => pm.expect(json.items.length).to.be.above(0));",
                  "}"
                ]
